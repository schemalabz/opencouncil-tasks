# Server Configuration
PORT=3005
NO_AUTH=true
CORS_ORIGINS_ALLOWED=https://opencouncil.gr,http://localhost:3000
PUBLIC_URL="http://localhost:3005"

# Digital Ocean Spaces Configuration
DO_SPACES_KEY=your-spaces-key
DO_SPACES_SECRET=your-spaces-secret
DO_SPACES_ENDPOINT=your-spaces-endpoint
DO_SPACES_BUCKET=your-spaces-name

# YouTube Downloads
YTDLP_PROXY=http://your-proxy-host:3128

# Observability (optional — all tracing is disabled when unset)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASEURL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=local   # native environment field; prod/staging set this to production/staging

# External Services
ANTHROPIC_API_KEY=your-anthropic-api-key
# Decision content extraction (attendance, votes, excerpts) in pollDecisions.
# Off unless exactly 'true': matching always runs; extraction waits until its
# output quality is trusted for the environment. Skipped decisions are picked
# up by later polls once enabled.
# DECISION_EXTRACTION_ENABLED=true
# Needs the speech_to_text permission
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# In-process cap on parallel Scribe requests (default: 15); account-wide
# overflow returns 429s, which are retried with backoff
# SCRIBE_MAX_CONCURRENT_TRANSCRIPTIONS=15
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
GOOGLE_API_KEY=your-google-api-key

## Pyannote
PYANNOTE_DIARIZE_API_URL="https://api.pyannote.ai/v1"
PYANNOTE_API_TOKEN=your-pyannote-api-token
MOCK_PYANNOTE=true

# Data Synchronization
ELASTICSEARCH_URL=https://your-cluster.es.region.aws.elastic.cloud:443
# Decode base64 API key: echo 'YOUR_BASE64_KEY' | base64 -d
# Output format: <id>:<secret>
ELASTICSEARCH_API_KEY_ID=your-api-key-id
ELASTICSEARCH_API_KEY=your-api-key-secret

# PGSync schema file (remote URL, e.g., GitHub Gist)
SCHEMA_URL=https://gist.githubusercontent.com/user/gist-id/raw/schema.json

# ---------------------------------------------------------------------------
# Fusion provider (three-system ASR: Scribe + Soniox + our adapter)
# Every knob is off by default; an invalid value stops the process at startup.
# With FUSION_MODE unset the app behaves exactly as it did before fusion existed.
# See plans/fusion-provider-shipping.md.
# ---------------------------------------------------------------------------
# FUSION_MODE=on                            # off | shadow | on
# FUSION_CANARY_PERCENT=100                 # `on` with 0 fuses nothing
# FUSION_LLM                                # retired. The LLM arbiter went with the
#                                           # Python engine; setting it to `on` now
#                                           # refuses to start rather than quietly
#                                           # serving the rules arm under its name.
# FUSION_OPENAI_ROUTE=off                   # benchmark-only surface
# FUSION_DEADLINE_MS=240000                 # shared by all three providers and fuse.py
# Directories below must be on a mounted volume: they hold transcript text.
# FUSION_RAW_LOG_DIR=/app/logs/fusion-raw   # the three raw word streams, gzipped; unset = not kept
# FUSION_RAW_LOG_RETENTION_DAYS=14           # records older than this are deleted; 0 = keep forever
# FUSION_RAW_LOG_MAX_BYTES=33554432         # size valve for one record
# FUSION_TRACE_DIR=/app/logs/fusion-traces  # default is $TMPDIR, lost on restart
# FUSION_CACHE_DIR=/app/data/fusion-cache   # default is $TMPDIR, lost on restart
# FUSION_PYTHON_BIN=python3
# FUSION_ENGINE=python                      # python | node. `node` runs the TypeScript
#                                           # port of the fuse core, which reproduces the
#                                           # Python's output on all 391 benchmark windows.
#                                           # The two are separate cache namespaces, so
#                                           # switching either way re-fuses rather than
#                                           # serving the other engine's cached results.
# Soniox: must be the paid stt-async-v5 account, not the free realtime model
# SONIOX_API_KEY=your-soniox-api-key
# Our own adapter, served by a RunPod serverless endpoint
# RUNPOD_API_KEY=your-runpod-api-key
# OC_ASR_ENDPOINT_ID=your-endpoint-id
